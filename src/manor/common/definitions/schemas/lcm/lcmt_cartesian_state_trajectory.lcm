package manor.common.definitions.lcmtypes;

struct lcmt_cartesian_state_trajectory {
    lcmt_timestamp_header header;
    int32_t num_steps;
    double times[num_steps];
    double translations_array[num_steps][3];
    double orientations_array[num_steps][4];
    double linear_array[num_steps][3];
    double angular_array[num_steps][3];
}
