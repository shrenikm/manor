package manor.common.definitions.lcmtypes;

struct lcmt_action {
    lcmt_timestamp_header header;

    // Group 1 (arm): exactly one variant set; tag identifies which.
    //   0 = joint_command
    //   1 = joint_trajectory_command
    //   2 = cartesian_command
    //   3 = cartesian_trajectory_command
    int8_t arm_variant;

    // Group 2 (ee): at most one variant set; -1 means none.
    //   -1 = none, 0 = ee_command, 1 = ee_trajectory_command
    int8_t ee_variant;

    lcmt_joint_command joint_command;
    lcmt_joint_trajectory_command joint_trajectory_command;
    lcmt_cartesian_command cartesian_command;
    lcmt_cartesian_trajectory_command cartesian_trajectory_command;
    lcmt_ee_command ee_command;
    lcmt_ee_trajectory_command ee_trajectory_command;
}
