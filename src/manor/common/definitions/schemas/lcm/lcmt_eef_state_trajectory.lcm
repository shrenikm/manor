package manor.common.definitions.lcmtypes;

struct lcmt_eef_state_trajectory {
    lcmt_timestamp_header header;
    int32_t num_steps;
    int32_t num_coords;
    double times[num_steps];
    double eef_positions_array[num_steps][num_coords];
    double eef_velocities_array[num_steps][num_coords];
}
