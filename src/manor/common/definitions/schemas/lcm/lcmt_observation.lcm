package manor.common.definitions.lcmtypes;

struct lcmt_observation {
    lcmt_timestamp_header header;

    boolean has_proprioception;
    lcmt_proprioception proprioception;

    boolean has_rgb_image;
    lcmt_rgb_image_data rgb_image;

    boolean has_rgbd_image;
    lcmt_rgbd_image_data rgbd_image;
}
